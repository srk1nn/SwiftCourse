{"variants":[{"paths":["\/documentation\/swiftcourse\/5-collections"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"text":"Дополнительные ссылки","anchor":"%D0%94%D0%BE%D0%BF%D0%BE%D0%BB%D0%BD%D0%B8%D1%82%D0%B5%D0%BB%D1%8C%D0%BD%D1%8B%D0%B5-%D1%81%D1%81%D1%8B%D0%BB%D0%BA%D0%B8","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/metanit.com\/swift\/tutorial\/2.9.php"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"https:\/\/metanit.com\/swift\/tutorial\/2.11.php","type":"reference","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/metanit.com\/swift\/tutorial\/2.12.php"}],"type":"paragraph"}]}]},{"level":2,"text":"Массивы (Array)","anchor":"%D0%9C%D0%B0%D1%81%D1%81%D0%B8%D0%B2%D1%8B-Array","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Массив — это структура данных, которая хранит элементы одного типа в определённом порядке.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Создание массива"}]}]},{"syntax":"swift","code":["\/\/ С явным указание типа","let fruits: Array<String> = [\"Apple\", \"Orange\"]","let fruits: [String] = [] \/\/ Пустой массив","","\/\/ Без явного указания типа","let fruits = [\"Apple\", \"Orange\"]","let fruits = [Int]() \/\/ Пустой массив"],"type":"codeListing"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Доступ к элементам массива"}]}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Каждый элемент массива доступен через его индекс. Индексация начинается с 0."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Чтение по индексу","let firstFruit = fruits[0]","","\/\/ Изменение элемента по индексу","fruits[1] = \"Strawberry\""]},{"code":["\/\/ Получение первого элемента массива","let firstFruit = fruits.first","","\/\/ Получение последнего элемента массива","let lastFruit = fruits.last"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Добавление элементов в массив"}]}]},{"syntax":"swift","code":["\/\/ Добавление в конец массива","fruits.append(\"Strawberry\")","","\/\/ Вставка элемента по индексу","fruits.insert(\"Strawberry\", at: 1)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Удаление элементов из массива"}]}]},{"code":["\/\/ Удаление элемента по индексу","fruits.remove(at: 2)","","\/\/ Удаление последнего элемента","fruits.removeLast()","","\/\/ Удаление первого элемента","fruits.removeFirst()","","\/\/ Удаление всех элементов","fruits.removeAll()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"inlineContent":[{"text":"Элементы","type":"text"}],"type":"strong"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Получение количества элементов в массиве","let count = fruits.count \/\/ Возвращает тип Int","","\/\/ Проверить, пустой ли массив","let empty = fruits.isEmpty \/\/ Возвращает Bool","","\/\/ Проверить, есть ли элемент","fruits.contains(\"Strawberry\")"]},{"anchor":"%D0%9C%D0%BD%D0%BE%D0%B6%D0%B5%D1%81%D1%82%D0%B2%D0%B0-Set","text":"Множества (Set)","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Множество — это коллекция уникальных элементов, которые не упорядочены. В отличие от массива, множество автоматически исключает повторяющиеся значения."}]},{"inlineContent":[{"type":"text","text":"Особенности множества"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Все элементы уникальны: добавление повторяющихся значений не изменяет множество.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Элементы множества не упорядочены, их порядок может быть произвольным."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Создание множества"}],"type":"strong"}]},{"type":"codeListing","syntax":"swift","code":["let fruits: Set<String> = [\"Apple\", \"Orange\"]","let fruits = Set<String>() \/\/ Пустое множество"]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Основные операции с множествами","type":"text"}]}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Добавить элемент","fruits.insert(\"Strawberry\")","","\/\/ Удалить элемент","fruits.remove(\"Strawberry\")","","\/\/ Удалить все элементы","fruits.removeAll()","","\/\/ Получение количества элементов","let count = fruits.count \/\/ Возвращает тип Int","","\/\/ Проверить, пустое ли множество","let empty = fruits.isEmpty \/\/ Возвращает Bool","","\/\/ Проверить, есть ли элемент","fruits.contains(\"Strawberry\")"]},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Операции над множествами"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Swift поддерживает базовые математические операции над множествами:"}],"type":"paragraph"},{"type":"heading","text":"Объединение (union):","anchor":"%D0%9E%D0%B1%D1%8A%D0%B5%D0%B4%D0%B8%D0%BD%D0%B5%D0%BD%D0%B8%D0%B5-union","level":4},{"type":"paragraph","inlineContent":[{"type":"text","text":"Создаёт новое множество, включающее все элементы из двух множеств."}]},{"code":["let setA: Set = [1, 2, 3]","let setB: Set = [3, 4, 5]","let unionSet = setA.union(setB)  \/\/ [1, 2, 3, 4, 5]"],"type":"codeListing","syntax":"swift"},{"level":4,"anchor":"%D0%9F%D0%B5%D1%80%D0%B5%D1%81%D0%B5%D1%87%D0%B5%D0%BD%D0%B8%D0%B5-intersection","type":"heading","text":"Пересечение (intersection):"},{"inlineContent":[{"text":"Создаёт новое множество из общих элементов двух множеств.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let intersectionSet = setA.intersection(setB)  \/\/ [3]"],"type":"codeListing"},{"text":"Разность (subtracting):","level":4,"type":"heading","anchor":"%D0%A0%D0%B0%D0%B7%D0%BD%D0%BE%D1%81%D1%82%D1%8C-subtracting"},{"type":"paragraph","inlineContent":[{"text":"Создаёт новое множество из элементов, которые есть в одном множестве, но отсутствуют в другом.","type":"text"}]},{"syntax":"swift","code":["let differenceSet = setA.subtracting(setB)  \/\/ [1, 2]"],"type":"codeListing"},{"anchor":"%D0%A1%D0%B8%D0%BC%D0%BC%D0%B5%D1%82%D1%80%D0%B8%D1%87%D0%BD%D0%B0%D1%8F-%D1%80%D0%B0%D0%B7%D0%BD%D0%BE%D1%81%D1%82%D1%8C-symmetricDifference","text":"Симметричная разность (symmetricDifference):","type":"heading","level":4},{"inlineContent":[{"text":"Создаёт новое множество из элементов, которые присутствуют только в одном из двух множеств.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let symmetricDifferenceSet = setA.symmetricDifference(setB)  \/\/ [1, 2, 4, 5]"]},{"anchor":"%D0%A1%D0%BB%D0%BE%D0%B2%D0%B0%D1%80%D0%B8-Dictionary","level":2,"type":"heading","text":"Словари (Dictionary)"},{"inlineContent":[{"type":"text","text":"Словарь — это коллекция, которая хранит пары “ключ-значение”. Ключи в словаре уникальны, а значения могут быть любыми."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Создание словаря"}]}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ С явным указание типа","let fruits: Dictionary<String, Int> = [\"Apple\": 2, \"Orange\": 1]","let fruits: [String: Int] = [:] \/\/ Пустой словарь","","\/\/ Без явного указания типа","let fruits = [\"Apple\": 2, \"Orange\": 1]","let fruits = [String: Int]() \/\/ Пустой словарь"]},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Доступ к данным"}]}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Получение значения по ключу","let appleNumber = fruits[\"Apple\"]","","\/\/ Изменение значения по ключу","fruits[\"Apple\"] = 10","","\/\/ Добавление новой пары","fruits[\"Strawberry\"] = 4","","\/\/ Удаление пары","fruits[\"Strawberry\"] = nil","","\/\/ Удаление всех элементов","fruits.removeAll()","","\/\/ Получение количества пар","let count = fruits.count \/\/ Возвращает тип Int","","\/\/ Проверить, пустой ли словарь","let empty = fruits.isEmpty \/\/ Возвращает Bool","","\/\/ Получение всех ключей в виде массива","let keys = fruits.keys","","\/\/ Получение всех значений в виде массива","let values = fruits.values"]}],"kind":"content"}],"identifier":{"url":"doc:\/\/SwiftCourse\/documentation\/SwiftCourse\/5-collections","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiftCourse\/documentation\/SwiftCourse"]]},"sections":[],"metadata":{"title":"[Конспект] 5. Коллекции","role":"article","modules":[{"name":"SwiftCourse"}],"roleHeading":"Article"},"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"https://metanit.com/swift/tutorial/2.9.php":{"titleInlineContent":[{"type":"text","text":"Массивы"}],"identifier":"https:\/\/metanit.com\/swift\/tutorial\/2.9.php","type":"link","url":"https:\/\/metanit.com\/swift\/tutorial\/2.9.php","title":"Массивы"},"doc://SwiftCourse/documentation/SwiftCourse":{"abstract":[{"text":"Этот репозиторий является сборником задач по языку Swift","type":"text"}],"url":"\/documentation\/swiftcourse","title":"SwiftCourse","kind":"symbol","role":"collection","type":"topic","identifier":"doc:\/\/SwiftCourse\/documentation\/SwiftCourse"},"https://metanit.com/swift/tutorial/2.11.php":{"titleInlineContent":[{"type":"text","text":"Множества"}],"identifier":"https:\/\/metanit.com\/swift\/tutorial\/2.11.php","type":"link","url":"https:\/\/metanit.com\/swift\/tutorial\/2.11.php","title":"Множества"},"https://metanit.com/swift/tutorial/2.12.php":{"titleInlineContent":[{"type":"text","text":"Словари"}],"identifier":"https:\/\/metanit.com\/swift\/tutorial\/2.12.php","type":"link","url":"https:\/\/metanit.com\/swift\/tutorial\/2.12.ph